---
import Icon from "../Icon.astro";
import { phones, viber, telegram, email, facebook, address, hours } from "../../data/site";
---
<section id="contacts" class="contacts on-forest" aria-labelledby="contacts-title" data-rec="U-R008,SM-R005">
  <div class="container grid">
    <h2 id="contacts-title" class="contacts__title" data-reveal>Пункт видачі на Радищева, 3 і всі способи зв'язку</h2>

    <div class="contacts__place">
      <p class="contacts__address">
        <span class="contacts__street">{address.street}</span>
        <span class="contacts__office"><span class="contacts__office-num tnum">229</span><span class="contacts__office-text">офіс 229, 2-й поверх<br />{address.city}</span></span>
      </p>
      <dl class="contacts__hours">
        {hours.map((h) => <div><dt>{h.days}</dt><dd class="tnum">{h.time}</dd></div>)}
      </dl>
      <a class="btn btn--paper" href={address.map} rel="noopener" target="_blank">
        <Icon name="route" /><span>Прокласти маршрут</span><span class="visually-hidden"> (Google Maps, нова вкладка)</span>
      </a>
    </div>

    <ul class="channels">
      {phones.map((p) => (
        <li><a class="channel" href={p.href}><Icon name="phone" /><span class="channel__value tnum">{p.display}</span><span class="channel__note">{p.note}</span></a></li>
      ))}
      <li><a class="channel" href={viber.href}><Icon name="viber" /><span class="channel__value tnum">{viber.display}</span><span class="channel__note">Viber</span></a></li>
      <li><a class="channel" href={telegram.href}><Icon name="telegram" /><span class="channel__value">{telegram.display}</span><span class="channel__note">Telegram</span></a></li>
      <li><a class="channel" href={`mailto:${email}`}><Icon name="mail" /><span class="channel__value">{email}</span><span class="channel__note">e-mail</span></a></li>
      <li><a class="channel" href={facebook} rel="noopener" target="_blank"><Icon name="facebook" /><span class="channel__value">Наша сторінка</span><span class="channel__note">Facebook</span><span class="visually-hidden"> (нова вкладка)</span></a></li>
    </ul>
  </div>
</section>
