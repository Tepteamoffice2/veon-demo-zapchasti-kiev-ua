---
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/site.css";
import "../styles/sections.css";

interface Props { lang: string; title: string; description: string; canonical?: string; }
const { lang, title, description, canonical } = Astro.props;
import sofiaCyr from "../assets/fonts/sofia-sans-condensed-cyrillic-ua-wght-normal.woff2?url";
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} data-rec="S-R002" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:site_name" content="Zapchasti.kiev.ua" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#EEF2EE" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href={sofiaCyr} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <style is:global>html, body { overflow-x: clip; }</style>
  </head>
  <body>
    <a class="skip-link" href="#main">{lang.startsWith("uk") ? "До змісту" : lang.startsWith("ru") ? "К содержанию" : "Skip to content"}</a>
    <slot name="header" />
    <main id="main" data-rec="U-R001,P-R001,P-R002,U-R014"><slot /></main>
    <slot name="footer" />
    <slot name="after" />
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>
