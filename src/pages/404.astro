---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import Icon from "../components/Icon.astro";
import { mainPhone, viber } from "../data/site";
---
<Base lang="uk" title="Сторінку не знайдено — Zapchasti.kiev.ua" description="Такої сторінки немає. Поверніться на головну або зв'яжіться з менеджером.">
  <header slot="header" class="site-header">
    <div class="container site-header__inner"><Logo href="/" /></div>
  </header>
  <section class="container notfound" aria-labelledby="nf-title">
    <h1 id="nf-title">Такої сторінки немає</h1>
    <p class="lead">Можливо, адреса змінилась. Почніть з головної або напишіть менеджеру, підкажемо.</p>
    <div class="btn-row">
      <a class="btn btn--primary" href="/">На головну</a>
      <a class="btn btn--secondary" href={mainPhone.href}><Icon name="phone" /><span>{mainPhone.display}</span></a>
      <a class="btn btn--secondary" href={viber.href}><Icon name="viber" /><span>Viber</span></a>
    </div>
  </section>
</Base>

<style>
  .notfound { display: grid; gap: var(--s-5); padding-block: var(--s-10); }
  .notfound h1 { font-size: var(--fs-h2); text-wrap: balance; }
</style>
